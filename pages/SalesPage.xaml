<UserControl x:Class="shop_pc.pages.SalesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="440"/>
        </Grid.ColumnDefinitions>

        <!-- Слева: выбор товара -->
        <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock Text="Поиск товара: название, артикул или характеристики"
                           Foreground="Gray" Margin="0,0,0,4"/>
                <TextBox Padding="8"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"/>
            </StackPanel>

            <Button DockPanel.Dock="Bottom" Content="В корзину →" Command="{Binding AddToCartCommand}"
                    Padding="16,10" Margin="0,12,0,0" HorizontalAlignment="Right"/>

            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      RowHeight="36" Background="White">
                <DataGrid.InputBindings>
                    <MouseBinding Gesture="LeftDoubleClick" Command="{Binding AddToCartCommand}"/>
                </DataGrid.InputBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул"   Binding="{Binding Sku}" Width="130"/>
                    <DataGridTextColumn Header="Название"  Binding="{Binding Name}" Width="2*"/>
                    <DataGridTextColumn Header="Цена"      Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="110"/>
                    <DataGridTextColumn Header="В наличии" Binding="{Binding StockQuantity}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Справа: корзина -->
        <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Корзина" FontSize="18"
                           FontWeight="Bold" Margin="0,0,0,12"/>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Total, StringFormat='Итого: {0:N2} ₽'}"
                               FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Button Content="Оформить продажу" Command="{Binding CheckoutCommand}"
                            Padding="14,12" FontWeight="Bold" Background="Green"
                            Foreground="White" BorderThickness="0"/>
                    <Button Content="Очистить корзину" Command="{Binding ClearCommand}"
                            Padding="14,8" Margin="0,8,0,0"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Cart}" AutoGenerateColumns="False"
                          IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" RowHeight="40" Background="White"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="*"/>

                        <DataGridTemplateColumn Header="Кол-во" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="−" Width="24" Command="{Binding DecreaseCommand}"/>
                                        <TextBlock Text="{Binding Quantity}" Width="30"
                                                   TextAlignment="Center" VerticalAlignment="Center"/>
                                        <Button Content="+" Width="24" Command="{Binding IncreaseCommand}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Сумма"
                                            Binding="{Binding LineTotal, StringFormat={}{0:N2}}" Width="90"/>

                        <DataGridTemplateColumn Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="✕" Command="{Binding RemoveCommand}"
                                            BorderThickness="0" Background="Transparent" Foreground="#DC2626"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>