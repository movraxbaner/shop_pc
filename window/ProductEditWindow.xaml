<Window x:Class="shop_pc.window.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:shop_pc.window"
        mc:Ignorable="d"
        Title="ProductEditWindow" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F3F4F6"> 
    <Border Background="White" CornerRadius="12" Margin="16" Padding="20">
        <StackPanel>
            <TextBlock Text="Артикул" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Sku, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12"/>

            <TextBlock Text="Название" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,12"/>

            <TextBlock Text="Категория" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedCategory}" Padding="8" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Цена, ₽" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Остаток, шт." Margin="0,0,0,4"/>
                    <TextBox Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged}" Padding="8"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Характеристики" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Specifications, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" Padding="16,8" Margin="0,0,8,0"/>
                <Button Content="Сохранить" IsDefault="True" Command="{Binding SaveCommand}"
                        Padding="16,8" FontWeight="Bold" Background="Green"
                        Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
