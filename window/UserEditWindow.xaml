<Window x:Class="shop_pc.window.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">
    <Border Background="White" CornerRadius="12" Margin="16" Padding="20">
        <StackPanel>
            <TextBlock Text="Логин" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8" Margin="0,0,0,12"/>

            <TextBlock Text="ФИО" Margin="0,0,0,4"/>
            <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8" Margin="0,0,0,12"/>

            <TextBlock Text="Роль" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding Roles}" DisplayMemberPath="RoleName"
                      SelectedItem="{Binding SelectedRole}"
                      IsEnabled="{Binding CanChangeRoleAndStatus}"
                      Padding="8" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding PasswordLabel}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordInput" Padding="8" Margin="0,0,0,12"
                         PasswordChanged="PasswordInput_PasswordChanged"/>

            <CheckBox Content="Учётная запись активна" IsChecked="{Binding IsActive}"
                      IsEnabled="{Binding CanChangeRoleAndStatus}" Margin="0,0,0,12"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" Padding="16,8" Margin="0,0,8,0"/>
                <Button Content="Сохранить" IsDefault="True" Command="{Binding SaveCommand}"
                        Padding="16,8" FontWeight="Bold" Background="Green"
                        Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>