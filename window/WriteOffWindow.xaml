<Window x:Class="shop_pc.window.WriteOffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:shop_pc.window"
        mc:Ignorable="d"
        Title="Списание товара" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#F3F4F6">
    <Border Background="White" CornerRadius="12" Margin="16" Padding="20">
        <StackPanel>
            <TextBlock Text="{Binding ProductInfo}" FontWeight="SemiBold"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <TextBlock Text="Количество, шт." Margin="0,0,0,4"/>
            <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8" Margin="0,0,0,12"/>

            <TextBlock Text="Причина" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                     Padding="8" Height="60" AcceptsReturn="True" TextWrapping="Wrap"
                     Margin="0,0,0,12"/>

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" IsCancel="True" Padding="16,8" Margin="0,0,8,0"/>
                <Button Content="Списать" IsDefault="True" Command="{Binding SaveCommand}"
                        Padding="16,8" FontWeight="Bold" Background="#DC2626"
                        Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
