<Window x:Class="shop_pc.window.Authorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:shop_pc.window"
        mc:Ignorable="d"
        Title="Authorization" Height="380" Width="360"
        Background="#F3F4F6">
    <Border Background="White" CornerRadius="12" Padding="20"
            Margin="20" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="Компьютерный магазин" FontSize="20"
                       FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Вход в систему" Foreground="Gray"  FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,-5,0,24" />
            
            <TextBlock Text="Логин" Margin="0,0,0,4"/>
            <TextBox x:Name="LoginBox" Padding="8" Margin="0,0,0,12"/>

            <TextBlock Text="Пароль" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordInput" Padding="8" Margin="0,0,0,20"/>

            <Button Content="Вход" FontWeight="Bold" Padding="8"
                    Background="Green" Foreground="White" BorderThickness="0"
                    Click="LoginButton"/>
            

        </StackPanel>
    </Border>
</Window>
