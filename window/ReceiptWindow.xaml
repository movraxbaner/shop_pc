<Window x:Class="shop_pc.window.ReceiptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чек" Width="430" Height="460" MinHeight="300"
        WindowStartupLocation="CenterOwner" Background="#F3F4F6">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Печать" Padding="16,8" Margin="0,0,8,0" Click="PrintButton_Click"/>
            <Button Content="Закрыть" IsDefault="True" IsCancel="True" Padding="16,8"/>
        </StackPanel>

        <Border Background="White" CornerRadius="8" Padding="16">
            <TextBox x:Name="ReceiptText" IsReadOnly="True" BorderThickness="0"
                     FontFamily="Consolas" FontSize="13"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Border>
    </DockPanel>
</Window>